{
  "name": "strata-descent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STRATA: Descent - first-person procedural dungeon crawler in a painted key (three.js, static build)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:build": "node tools/checkBuild.mjs",
    "test": "npm run test:levels && npm run test:loot && npm run test:movement && npm run test:case",
    "test:levels": "node tools/validateLevels.mjs 200",
    "test:case": "node tools/caseCheck.mjs",
    "test:loot": "node tools/simulateLoot.mjs 6000",
    "test:movement": "node tools/testMovement.mjs",
    "test:game": "node tools/runSelfTest.mjs",
    "test:keys": "node tools/keyCheck.mjs",
    "qa:art": "node tools/unusedArt.mjs",
    "qa:seams": "node tools/pageShot.mjs seamcheck.html seamcheck.png 1620 2900",
    "qa:keys": "node tools/pageShot.mjs keycheck.html keycheck.png 1150 1700",
    "qa:props": "node tools/pageShot.mjs propcheck.html propcheck.png 1400 820",
    "qa:fx": "node tools/pageShot.mjs fxcheck.html fxcheck.png 1300 720",
    "qa:alpha": "node tools/pageShot.mjs alphacheck.html alphacheck.png 1150 1500",
    "qa:arrow": "node tools/pageShot.mjs index.html arrowcheck.png 900 560 \"?demo=1&seed=bravo&depth=2&preview=archer&tier=2&previewshoot=1&freeze=1\"",
    "qa:bow": "node tools/pageShot.mjs index.html bowcheck.png 900 560 \"?demo=1&seed=bravo&depth=2&arrows=6&shoot=1&freeze=1&mark=1\"",
    "qa:props:one": "node tools/pageShot.mjs propcheck.html propcheck.png 900 620",
    "shot": "node tools/pageShot.mjs"
  },
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
